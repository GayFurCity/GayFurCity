<%= form_search(path: domain_icon_media_assets_path, policy: policy(DomainIconMediaAsset)) do |f| %>
  <%= f.user(:creator) %>
  <%= f.input(:checksum) %>
  <%= f.input(:md5, label: "MD5") %>
  <%= f.input(:file_ext, label: "Type") %>
  <%= f.input(:pixel_hash, label: "Pixel Hash") %>
  <%= f.input(:status, collection: DomainIconMediaAsset.statuses) %>
  <%= f.input(:status_message_matches, label: "Status Message") %>
  <%= f.input(:domain_icon_id, label: "Domain Icon") %>
<% end %>
