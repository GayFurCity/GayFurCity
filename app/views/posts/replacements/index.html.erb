<h1>Post Replacements</h1>

<%= render("search") %>
<%= render("posts/partials/common/inline_blacklist") %>

<div class="<%= @timeline ? "replacement-timeline" : "replacement-list" %>">
  <%= render(partial: "card", collection: @post_replacements, as: :post_replacement, locals: { timeline: @timeline }) %>
</div>

<%= numbered_paginator(@post_replacements) %>

<%= render("secondary_links") %>

<% content_for(:page_title) do %>
  Post Replacements
<% end %>
