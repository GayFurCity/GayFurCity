<%= render("search") %>

<%= table_for(@tags) do |t| %>
  <% t.column("Count") do |tag| %>
    <%= tag.post_count %>
  <% end %>
  <% t.column("Name", th: { class: "col-expand" }) do |tag| %>
    <% marker = tag.is_deprecated? ? deprecated_tag_icon : "?" %>
    <span class="category-<%= tag.category %>">
      <% if tag.artist? %>
        <%= link_to(marker, show_or_new_artists_path(name: tag.name), class: "wiki-link") %>
      <% else %>
        <%= link_to_wiki_or_new(marker, tag.name, class: "wiki-link") %>
      <% end %>
      <%= link_to(tag.name, posts_path(tags: tag.name), class: ("deprecated-tag" if tag.is_deprecated?)) %>
    </span>
  <% end %>
  <% t.column do |tag| %>
    <%= link_to("view", tag_path(tag)) %> |
    <% if policy(tag).update? %>
      <%= link_to("edit", edit_tag_path(tag)) %> |
    <% end %>
    <%= link_to("history", tag_versions_path(search: { tag_id: tag.id })) %>
    <% if policy(tag).correct? %>
      | <%= link_to("fix", correct_tag_path(tag), method: :put) %>
    <% end %>
  <% end %>
<% end %>

<%= numbered_paginator(@tags) %>

<%= render("secondary_links") %>

<% content_for(:page_title) do %>
  Tags
<% end %>
