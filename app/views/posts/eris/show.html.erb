<h1>Similar Images Search</h1>
<%= form_search(path: posts_eris_path, hideable: false, method: :post) do |f| %>
  <%= f.input(:post_id, label: "Post ID") %>
  <%= f.input(:url, label: "URL") %>
  <%= f.input(:file, as: :file) %>
  <%= f.input(:score_cutoff, label: "Similarity", default: 60) %>
<% end %>

<% if @error %>
  <p><span class="error"><%= @error %></span></p>
<% end %>

<%= render("posts/partials/common/inline_blacklist") %>
<%= render("posts/eris/matches") unless @error %>

<% content_for(:page_title) do %>
  Similar Images Search
<% end %>
