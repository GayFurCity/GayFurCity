<%
  presenter = PostReplacementPresenter.new(
    replacement: post_replacement,
    user: CurrentUser.user,
    timeline: local_assigns.fetch(:timeline, false),
    expanded: local_assigns[:expanded],
    actions: local_assigns.fetch(:actions, true),
  )
  replacement = presenter.replacement
%>
<div
  id="replacement-<%= replacement.id %>"
  class="<%= presenter.card_classes %>"
  data-replacement-id="<%= replacement.id %>"
  role="group"
  aria-labelledby="replacement-<%= replacement.id %>-title"
>
  <% if presenter.timeline? %><span class="replacement-dot<%= " is-current" if replacement.is_current? %>" aria-hidden="true"></span><% end %>

  <div class="replacement-card-thumb"><%= replacement_thumbnail(replacement) %></div>

  <div class="replacement-card-header">
    <div class="replacement-card-heading">
      <div class="replacement-card-title" id="replacement-<%= replacement.id %>-title">
        <span class="replacement-status-link">
          <%= link_to(replacement.post_id, post_path(replacement.post_id), class: "replacement-version") %>:<%= replacement.sequence_number %>
        </span>
        <span class="replacement-status-label">
          <% presenter.highlighted_tags.each do |tag_name| %>
            <%= svg_icon(presenter.status_tag_icon(tag_name), title: tag_name, height: 13.5, width: 13.5, class: "inline-icons") if presenter.status_tag_icon(tag_name) %>
          <% end %>
          <span class="replacement-status"><%= replacement.status %></span>
          <% if replacement.is_current? %>
            <span class="replacement-annotation">(current)</span>
          <% elsif replacement.approved? %>
            <span class="replacement-annotation">(retired)</span>
          <% elsif replacement.promoted? && replacement.promoted_id.present? %>
            <span class="replacement-annotation">(#<%= link_to(replacement.promoted_id.to_s, post_path(replacement.promoted_id)) %>)</span>
          <% end %>
        </span>
      </div>

      <div class="replacement-card-meta">
        <%= link_to_user(replacement.creator) %><% if replacement.uploader_linked_artists.any? %>&nbsp;<%= svg_icon(:chexagon, class: "chexagon", title: "The replacer is linked to one of the artist tags") %><% end %>
        <span class="replacement-meta-sep">&middot;</span><%= compact_time(replacement.created_at) %>
        <% if replacement.approver.present? %>
          <span class="replacement-meta-sep">&middot;</span>
          <span class="replacement-meta-handled">handled by <%= link_to_user(replacement.approver) %></span>
        <% end %>
      </div>
    </div>

    <button type="button" class="replacement-card-toggle" aria-label="Toggle details" aria-expanded="<%= presenter.expanded? ? "true" : "false" %>" aria-controls="replacement-<%= replacement.id %>-body">
      <span aria-hidden="true"><%= svg_icon(:chevron_down, class: "replacement-chevron") %></span>
    </button>
  </div>

  <div class="replacement-card-body" id="replacement-<%= replacement.id %>-body">
    <div class="replacement-fields">
      <div class="replacement-field">
        <div class="replacement-field-label">Image info</div>
        <div class="replacement-field-value">
          <%= svg_icon(:circle_check_small, title: "This is the current version", height: 13.5, width: 13.5, class: "inline-icons") if replacement.is_current? %>
          <% if replacement.pending? %>
            New: <%= presenter.file_details(replacement) %>
            <br>Old: <%= presenter.file_details(presenter.post) %>
          <% else %>
            <%= presenter.file_details(replacement) %>
          <% end %>
        </div>
      </div>

      <div class="replacement-field">
        <div class="replacement-field-label">File name</div>
        <div class="replacement-field-value"><%= truncate(replacement.file_name, length: 64) %></div>
      </div>

      <% if replacement.md5.present? %>
        <div class="replacement-field">
          <div class="replacement-field-label">MD5</div>
          <div class="replacement-field-value is-mono"><%= replacement.md5 %></div>
        </div>
      <% end %>

      <div class="replacement-field">
        <div class="replacement-field-label"><%= presenter.created_at_label %></div>
        <div class="replacement-field-value"><%= compact_time(replacement.created_at) %></div>
      </div>

      <% if presenter.show_status_changed_at? %>
        <div class="replacement-field">
          <div class="replacement-field-label">Status changed at</div>
          <div class="replacement-field-value"><%= compact_time(replacement.updated_at) %></div>
        </div>
      <% end %>

      <% if presenter.show_previous_uploader? %>
        <div class="replacement-field">
          <div class="replacement-field-label">Previous uploader</div>
          <div class="replacement-field-value">
            <%= link_to_user(replacement.uploader_on_approve) %>
            <% if presenter.show_penalize_toggle? %>
              | penalized: <span class="penalized-status"><%= replacement.penalize_uploader_on_approve? ? "yes" : "no" %></span>
              <%= link_to("toggle", "#toggle", class: "replacement-toggle-penalize-action", data: { replacement_id: replacement.id }) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="replacement-field replacement-field-full-width">
        <div class="replacement-field-label">Reason</div>
        <div class="replacement-field-value replacement-reason"><%= replacement.reason.presence || "None provided" %></div>
      </div>

      <% if replacement.rejected? %>
        <div class="replacement-field replacement-field-full-width">
          <div class="replacement-field-label">Rejected by</div>
          <div class="replacement-field-value">
            <%= link_to_user(replacement.rejector) %>
            <% if replacement.rejection_reason.present? %> &mdash; <%= replacement.rejection_reason %><% end %>
          </div>
        </div>
      <% end %>

      <div class="replacement-field replacement-field-full-width">
        <div class="replacement-field-label">Sources</div>
        <div class="replacement-field-value">
          <% if presenter.sources.any? %>
            <div class="replacement-sources">
              <% presenter.sources.each do |source| %>
                <div class="source-link"><%= post_source_tag(source) %></div>
              <% end %>
            </div>
          <% else %>
            <em>None provided</em>
          <% end %>
        </div>
      </div>
    </div>

    <% if presenter.actions %>
      <div class="replacement-card-actions">
        <% if presenter.show_staff_actions? %>
          <div class="pending-links">
            <% if presenter.show_approve? %>
              <%= link_to("Approve", "#approve", class: "replacement-approve-action st-button success", data: { replacement_id: replacement.id, penalize: presenter.approve_penalizes? }) %>
              <% if CurrentUser.user.is_admin? %>
                <label class="replacement-force-missing-backup is-hidden">
                  <input type="checkbox" class="replacement-force-missing-backup-checkbox" data-replacement-id="<%= replacement.id %>">
                  Force (original file missing from storage)
                </label>
              <% end %>
            <% end %>
            <% if presenter.show_reject? %>
              <%= link_to("Reject", "#reject", class: "replacement-reject-action st-button danger", data: { replacement_id: replacement.id }) %>
            <% end %>
          </div>
          <% if presenter.show_reject_with_reason? %>
            <%= link_to("Reject With Reason", reject_with_reason_post_replacement_path(replacement), class: "replacement-reject-with-reason-action st-button danger") %>
          <% end %>
          <% if presenter.show_promote? %>
            <%= link_to("As New Post", "#promote", class: "replacement-promote-action st-button", data: { replacement_id: replacement.id }) %>
          <% end %>
          <% if presenter.show_reset_to? %>
            <%= link_to("Reset To", "#reset-to", class: "replacement-approve-action st-button", data: { replacement_id: replacement.id, penalize: false }) %>
          <% end %>
          <% if presenter.show_transfer? %>
            <%= link_to("Transfer", "#transfer", class: "replacement-transfer-action st-button", data: { replacement_id: replacement.id }) %>
          <% end %>
        <% end %>

        <% if presenter.show_destroy? %>
          <%= link_to("Destroy", "#destroy", class: "replacement-destroy-action st-button danger", data: { replacement_id: replacement.id }) %>
        <% end %>

        <span class="replacement-action-spacer"></span>
        <%= link_to("⚑ Report", model_new_ticket_path(model: replacement), class: "replacement-report-action st-button") %>
      </div>
    <% end %>
  </div>
</div>
