<h2>
  <%= link_to(@pool.pretty_name, posts_path(tags: "pool:#{@pool.id}")) %>
  <% if @pool.is_ongoing? %><span class="hint">ongoing</span><% end %>
</h2>

<% if @pool.is_indexing? %>
  <div class="indexing-notice">
    Recently added or removed posts are still being reindexed and may not yet appear correctly in search results.
    <% if policy(@pool).clear_indexing? %>
      | <%= link_to("Clear notice", clear_indexing_pool_path(@pool), method: :put, data: { confirm: "Clear the indexing notice? Only do this if it appears stuck." }) %>
    <% end %>
  </div>
<% end %>

<div id="description" class="dtext-container">
  <%= format_text(@pool.description) %>
</div>

<%= render("posts/partials/common/inline_blacklist") %>

<div id="posts" class="user-disable-cropped-<%= AdminConfig.instance.enable_image_cropping? && CurrentUser.user.disable_cropped_thumbnails? %>">
  <div id="posts-container">
    <% if @posts.none? %>
      <%= render("posts/blank") %>
    <% else %>
      <% @posts.each do |post| %>
        <%= PostPresenter.preview(post, pool_id: @pool.id, show_cropped: true, show_deleted: true) %>
      <% end %>
    <% end %>
  </div>
</div>
<%= numbered_paginator(@posts) %>

<%= render("secondary_links") %>

<% render(partial: "static/embed", locals: { record: @pool, name: @pool.pretty_name, description: @pool.description, post: @pool.cover_post }) %>

<% content_for(:page_title) do %>
  Pool - <%= @pool.pretty_name %>
<% end %>
