<h1>Most Viewed: <%= date_range_description(@date, @scale, @min_date, @max_date) %></h1>
<p id="total">
  Total Views: <%= ActiveSupport::NumberHelper.number_to_delimited(@ranking.sum(&:second)) %>
</p>

<%= @post_set.presenter.nav_links %>

<%= render("posts/partials/common/inline_blacklist") %>

<div id="posts" class="user-disable-cropped-<%= AdminConfig.instance.enable_image_cropping? && CurrentUser.user.disable_cropped_thumbnails? %>">
  <div id="posts-container">
    <%= @post_set.presenter.post_previews_html(self, show_cropped: true, views: :daily, views_list: @ranking, unique_views: false) %>
  </div>
</div>


<%= render(partial: "popular/secondary_links") %>
<% content_for(:secondary_links) { "|" } %>
<%= render("posts/partials/common/secondary_links") %>

<% content_for(:page_title) do %>
  Popular Posts for <%= date_range_description(@date, @scale, @min_date, @max_date) %>
<% end %>

<% content_for(:html_header) do %>
  <meta name="description" content="The most viewed posts per day">
<% end %>
