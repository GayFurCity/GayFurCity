<div id="c-posts-search">
  <h1>Advanced Search</h1>
  <p>
    General tags work the same as the normal search bar. Use "+ Add a search option" below to add
    specific fields (rating, score, dates, character groups, tag groups, etc) one at a time as you need them.
    <%= link_to("(search help)", help_page_path(id: "cheatsheet")) %>
  </p>

  <%= form_tag(search_posts_path, method: "post", id: "post-search-form") do %>
    <div id="post-search-builder"
         data-fields="<%= PostSearch::Fields.fields.map(&:to_h).to_json %>"
         data-general-tags="<%= @search_form.general_tags %>"
         data-groups="<%= @search_form.character_groups.to_json %>"
         data-bool-groups="<%= @search_form.bool_groups.to_json %>"
         data-values="<%= @search_form.field_values.to_json %>"
         data-modes="<%= @search_form.field_modes.to_json %>"></div>

    <div class="input post-search-submit">
      <%= submit_tag("Search") %>
    </div>
  <% end %>
</div>

<% content_for(:page_title) do %>
  Advanced Search
<% end %>
