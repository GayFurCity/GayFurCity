                    <div class="col2">
                      <div class="flex-wrap">
                        <image-checkbox :check="checkboxes.cub" :checks="checkboxes.selected" @set="setCheck"></image-checkbox>
                        <div class=" hide-default">
                          <image-checkbox :check="check" :checks="checkboxes.selected"
                                        v-for="check in checkboxes.cubAge" @set="setCheck"
                                        :key="check.name" :data-tag="check.tag || check.name.toLowerCase().replace(/ /g, '_')"></image-checkbox>
