                      <textarea class="tag-textarea" v-model="tagEntries.content" id="post_content" rows="2"
                        data-autocomplete="tag-edit"
                        placeholder="Ex: cub scatplay watersports diaper my_little_pony vore rape hyper etc."></textarea>
                    </div>
