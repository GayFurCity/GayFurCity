                        <image-checkbox :check="check" :checks="checkboxes.selected"
                                        v-for="check in checkboxes.cubGender" @set="setCheck"
                                        :key="check.name" :data-tag="check.tag || check.name.toLowerCase().replace(/ /g, '_')" :data-gender-tag="check.gender" data-is-cub="true"></image-checkbox>
                      </div>
                      <div class="flex-wrap hide-default">
                        <image-checkbox :check="check" :checks="checkboxes.selected"
