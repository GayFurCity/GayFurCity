            </div>
            <div class="flex-grid border-bottom">
                <div class="col">
                    <label class="section-label" for="post_description">Description</label>
                </div>
                <div class="col2">
                    <%= ApplicationController.new.render_to_string(partial: "dtext_input", locals: { limit: AdminConfig.instance.post_description_max_size, textarea: '<textarea  class="dtext-formatter-input tag-textarea dtext" id="post_description" rows="10" v-model="description"></textarea>'.html_safe, allow_color: true }) %>
                </div>
            </div>
            <div v-if="allowUploadAsPending || allowUploadAsInProgress" class="flex-grid border-bottom">
                <div class="col">
                    <label class="section-label">Upload Options</label>
                </div>
                <div class="col2">
                    <label><input type="checkbox" v-model="uploadAsPending"/> Upload As Pending<sup title="Puts the post straight into the pending queue for approval, even if you'd normally skip it." style="cursor: help; margin-left: 0.15em; font-size: 0.75em;">?</sup></label><br>
                    <label><input type="checkbox" v-model="uploadAsInProgress"/> Upload As In Progress<sup title="Hides the post from search results until searched for directly, and lets you replace it instantly with no approval needed while you keep working on it. Push it into the pending queue yourself when you're done, or a janitor can force it in if it's abandoned." style="cursor: help; margin-left: 0.15em; font-size: 0.75em;">?</sup></label>
                </div>
