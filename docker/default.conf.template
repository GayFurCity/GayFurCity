server {
  listen ${NGINX_PORT};
  server_name localhost;
  root /app/public;
  index index.html;
  access_log off;
  client_max_body_size 100m;

  location /data {
    expires max;
    break;
  }

  location /data/posts/deleted/ {
    add_header Cache-Control "private";
    secure_link $arg_auth,$arg_expires;
    secure_link_md5 "$secure_link_expires $uri $arg_uid ${GAYFURCITY_PROTECTED_FILE_SECRET}";
    if ($secure_link = "") {
      return 403;
    }
    if ($secure_link = "0") {
      return 403;
    }
  }

  location /data/replacements/ {
    add_header Cache-Control "private";
    secure_link $arg_auth,$arg_expires;
    secure_link_md5 "$secure_link_expires $uri $arg_uid ${GAYFURCITY_REPLACEMENT_FILE_SECRET}";
    if ($secure_link = "") {
      return 403;
    }
    if ($secure_link = "0") {
      return 403;
    }
}

  location /tags/autocomplete.json {
    proxy_pass http://autocompleted:8118/;
    proxy_redirect off;
  }

  location /reports {
    proxy_pass http://reports:3000;
    proxy_redirect off;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Port ${NGINX_PROXY_PORT};
    proxy_set_header X-Forwarded-Proto ${NGINX_PROXY_SCHEME};
    rewrite ^/reports/(.*)$ /$1 break;
  }

  location @app_server {
    proxy_pass http://app_server;
    proxy_redirect off;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host ${NGINX_PROXY_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Port ${NGINX_PROXY_PORT};
    proxy_set_header X-Forwarded-Proto ${NGINX_PROXY_SCHEME};
  }

  location / {
    try_files $uri @app_server;
  }

  location = /online {
    access_log off;
    return 204;
  }

  error_page 404 /404.html;
  error_page 500 502 503 504 /500.html;
}

upstream app_server {
  server gayfurcity:9000;
}
