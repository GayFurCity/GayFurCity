#!/usr/bin/env ruby
APP_PATH = File.expand_path("../config/application", __dir__)
require_relative "../config/boot"
# rails/commands shifts the command name off of ARGV before booting the app, so config/config.rb
# keeps its own copy to detect generator invocations (see Config#generator_invocation?).
ORIGINAL_ARGV = ARGV.dup
require "rails/commands"
